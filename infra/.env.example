# Copy to infra/.env and adjust for local overrides — never commit real secrets.

APP_JWT_SECRET=dev-only-jwt-signing-secret-do-not-use-in-prod-32bytes+
# 32 bytes, base64 — generate your own with: openssl rand -base64 32
APP_ENCRYPTION_KEY=jSw4UvsjHkkm+6EBGiIn3znFCRNWqBY0USucGw1hYeg=

# Open Banking provider — placeholders only, unused while the mock provider is
# active. Populated in Phase 5 once {{OPEN_BANKING_PROVIDER}} is selected.
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_WEBHOOK_SECRET=
OPEN_BANKING_REDIRECT_URL=
