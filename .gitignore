# OS
.DS_Store

# Java / Maven
apps/api/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Node / Next.js
apps/web/node_modules/
apps/web/.next/
apps/web/out/
npm-debug.log*

# Env / secrets — never commit real values
.env
.env.local
*.env
!*.env.example

# IDE
.idea/
.vscode/
*.iml

# Logs
*.log

# Claude Code session artifacts
.claude/

# Terraform — provider binaries and local plan/state artifacts, never the
# module code or the lock file (both of those ARE committed)
**/.terraform/
*.tfplan
*.tfstate
*.tfstate.*
crash.log
crash.*.log
